    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "dotenv": "^17.4.2",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
